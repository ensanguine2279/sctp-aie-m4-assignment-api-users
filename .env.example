# Copy this file to .env and fill it in:  cp .env.example .env
# .env holds passwords, so it must stay out of version control.
# Every variable here is read by docker-compose.yml.

# ----------------------------------------------------
# Database
# ----------------------------------------------------
DB_PORT_ENV=5432
DB_NAME_ENV=userdb
DB_USER_ENV=postgres
# Change this. It is used to create the database and by the application to connect.
DB_PASSWORD_ENV=change-me

# ----------------------------------------------------
# Application
# ----------------------------------------------------
# Port the service listens on, and the port published on the host.
APP_PORT_ENV=8080

# ----------------------------------------------------
# JWT (RS256)
# ----------------------------------------------------
# Token lifetime in milliseconds (3600000 = 1 hour). Keep it short: tokens cannot be revoked.
JWT_EXPIRATION_MS_ENV=3600000

# Written into every token and checked when one is validated.
# The task API must be configured with exactly the same two values.
JWT_ISSUER_ENV=user-service
JWT_AUDIENCE_ENV=taskflow-api

# Host path of the private key, mounted into the container as a secret.
# Leave this commented out to use the default in docker-compose.yml: ~/.taskflow/keys/private.pem
# Create the key pair first (see the "Signing keys (RS256)" section of README.md).
# Never put the key's contents in this file, only its path.
# JWT_PRIVATE_KEY_FILE=/home/you/.taskflow/keys/private.pem

# The container runs as this numeric user so it can read the mounted key.
# Find yours with `id -u` and `id -g`. Both default to 1000 if left out.
# LOCAL_UID=1000
# LOCAL_GID=1000

# ----------------------------------------------------
# First admin (optional)
# ----------------------------------------------------
# Created on startup only when both are set and the users table is empty.
# Username: 6 to 20 lowercase letters or digits. Password: 8 to 72 characters.
# Once the admin exists, remove both lines and restart so the password does not stay in a file.
ADMIN_USERNAME_ENV=change-me-too
ADMIN_PASSWORD_ENV=change-me-too
