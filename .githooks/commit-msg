#!/bin/sh
# commit-msg hook: the commit subject must follow Conventional Commits,
# because semantic-release reads it to decide the next version.

# The subject is the first line that is neither blank nor a git comment.
subject=$(grep -v '^#' "$1" | grep -v '^[[:space:]]*$' | head -n 1)

# Let git's own generated messages through.
case "$subject" in
    "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# Lowercase types only: semantic-release ignores "Feat:" or "FIX:".
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'

if ! printf '%s\n' "$subject" | grep -qE "$pattern"; then
    echo "================================================================="
    echo "INVALID COMMIT MESSAGE FORMAT"
    echo "================================================================="
    echo "Your commit subject: \"$subject\""
    echo ""
    echo "It must follow the Conventional Commits standard:"
    echo "  <type>[optional scope]: <description>"
    echo ""
    echo "Types: feat fix docs style refactor perf test build ci chore revert"
    echo "Releases: feat -> minor; fix, perf, revert -> patch;"
    echo "          '!' or 'BREAKING CHANGE:' footer -> major; others -> none"
    echo ""
    echo "Examples:"
    echo "  feat(auth): add JWT authentication endpoint"
    echo "  fix(db): resolve HikariCP connection pool leak"
    echo "  chore(deps): update Spring Boot to 4.1.0"
    echo "================================================================="
    exit 1
fi